# Copie para .env (na mesma pasta infra/) e troque os valores.
# O arquivo .env NUNCA vai para o Git.

# ---------------------------------------------------------------------------
# Banco central (PostgreSQL)
# ---------------------------------------------------------------------------
# Senha do superusuário "postgres" (administração e acesso manual pelo psql/DBeaver)
POSTGRES_PASSWORD=troque-esta-senha

# Senhas dos usuários de cada serviço (cada um só acessa o próprio schema)
MS_AUTH_DB_PASSWORD=troque-esta-senha-auth
MS_CLINICO_DB_PASSWORD=troque-esta-senha-clinico
MS_DOCS_DB_PASSWORD=troque-esta-senha-docs

# Porta do Postgres na própria VM (aberta só em 127.0.0.1).
# 5433 evita conflito com um Postgres que já esteja instalado na VM.
DB_PORTA_LOCAL=5433

# ---------------------------------------------------------------------------
# Gateway (Nginx)
# ---------------------------------------------------------------------------
# Porta pública do sistema (portal + API)
HTTP_PORTA=80

# ---------------------------------------------------------------------------
# Dados de demonstração (scripts/popular-demo.sh)
# ---------------------------------------------------------------------------
# Senha das contas de demonstração do roteiro de testes. O repositório e a VM são
# públicos: use uma senha forte, só sua, e não a publique em lugar nenhum.
DEMO_SENHA=troque-esta-senha-de-demo

# ---------------------------------------------------------------------------
# ms-clinico
# ---------------------------------------------------------------------------
# Regra de unificação de duplicados: MAIS_RECENTE_VENCE (padrão) ou SERVIDOR_VENCE
ESTRATEGIA_CONFLITO=MAIS_RECENTE_VENCE

# ---------------------------------------------------------------------------
# Próximas etapas (ainda não usadas)
# ---------------------------------------------------------------------------
# E-mail (ms-docs): conta Gmail do projeto com "senha de app"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORTA=587
# SMTP_USUARIO=conta-do-projeto@gmail.com
# SMTP_SENHA=senha-de-app-de-16-letras
# SMTP_REMETENTE=MedicalField <conta-do-projeto@gmail.com>

    REP["<b>Repository</b><br/>App: um repositório por tabela do SQLite<br/>ms-clinico: Repositorio* · ms-docs: RepositorioEnvios<br/><i>quem usa não sabe de onde vêm os dados</i>"]
    STR["<b>Strategy</b><br/>ms-clinico: EstrategiaDeMesclagem<br/>MaisRecenteVence · ServidorVence<br/><i>regra de conflito trocada por configuração</i>"]

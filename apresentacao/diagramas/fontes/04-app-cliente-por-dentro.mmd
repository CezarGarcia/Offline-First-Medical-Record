%% O app cliente por dentro: dois processos do Electron e o que cada um pode fazer
flowchart TB
  subgraph R["Processo de renderização (Chromium) · sem Node.js, sem rede, sem banco"]
    direction TB
    T1["Telas React<br/>Nova ocorrência · Pacientes · Atendimentos<br/>Fila de sincronização · Logs locais · Sobre"]
    T2["window.medicalfield<br/>(só 2 funções: chamar e ouvir)"]
    T1 --> T2
  end
  P["<b>preload</b><br/>a ponte (contextBridge)"]
  subgraph M["Processo principal (Node.js) · o Núcleo local"]
    direction TB
    N["<b>Núcleo</b> (fachada)<br/>só atende os métodos do contrato ApiDoNucleo"]
    REG["Registros<br/>grava dado + fila numa transação"]
    REPO["Repositórios<br/>os únicos com SQL"]
    SYNC["Motor de sincronização<br/>envio · recebimento · credenciais · logs"]
    CMD["Comandos (Command)<br/>CriarPessoa · CriarProntuario<br/>CriarAtendimento · EnviarEmail"]
    CON["EstadoConectividade (Observer)<br/>a chave Online/Offline"]
    SES["Sessão<br/>login online/offline · tokens"]
    HTTP["Cliente HTTP<br/>recusa tudo com a chave em Offline"]
    DB[("SQLite")]
    N --> REG --> REPO --> DB
    N --> SES
    SYNC --> CMD --> HTTP
    SYNC --> REPO
    CON -. "avisa: Online → sincroniza" .-> SYNC
    CON -. "avisa: Offline → cancela" .-> HTTP
    SES --> HTTP
  end
  T2 -- "IPC: mensagem<br/>{ método, argumentos }" --> P --> N
  N -. "avisos: estado mudou,<br/>dados mudaram" .-> P
  HTTP -- "HTTP + JWT" --> VM["Nginx da VM"]

  classDef ts fill:#dbeafe,stroke:#2563eb,color:#0b1f44
  classDef banco fill:#ede9fe,stroke:#6d28d9,color:#21094d
  classDef fora fill:#ffffff,stroke:#94a3b8,color:#111827,stroke-dasharray:4 3
  class T1,T2,P,N,REG,REPO,SYNC,CMD,CON,SES,HTTP ts
  class DB banco
  class VM fora

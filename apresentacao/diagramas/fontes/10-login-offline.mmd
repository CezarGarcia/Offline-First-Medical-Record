%% Como o app decide o login (online, offline pela credencial do aparelho ou pela réplica do servidor)
flowchart TD
  A["Registro + senha"] --> B{"Chave em Online?"}
  B -- sim --> C["POST /api/auth/login"]
  C -- "200" --> D["Sessão ONLINE<br/>guarda o verificador scrypt neste aparelho"]
  C -- "401 / 403 / 423" --> E["Mostra o erro<br/>(não tenta offline)"]
  C -- "sem resposta" --> F["Aviso: servidor inacessível"]
  B -- não --> G
  F --> G{"O aparelho conhece esse registro?"}
  G -- "não, e nunca sincronizou" --> H["O primeiro acesso neste aparelho<br/>precisa de conexão"]
  G -- "não, mas já sincronizou" --> H2["Registro ou senha incorretos<br/>(não revela quem existe)"]
  G -- sim --> I["Escolhe a confirmação do servidor mais recente:<br/>credencial do aparelho (scrypt)<br/>ou réplica de credenciais (bcrypt, D-51)"]
  I --> J{"Vencida (7 dias)<br/>ou bloqueada?"}
  J -- sim --> K["Mostra o motivo"]
  J -- não --> L{"A senha confere?"}
  L -- não --> M["Conta a tentativa<br/>5ª seguida: bloqueio de 5 min"]
  L -- sim --> N["Sessão OFFLINE<br/>senha só na memória: login online sozinho<br/>quando a conexão voltar"]
  classDef ok fill:#dcfce7,stroke:#15803d,color:#05300f
  classDef erro fill:#fee2e2,stroke:#b91c1c,color:#450a0a
  class D,N ok
  class E,H,H2,K,M erro

%% Visão geral: quem conversa com quem, em que linguagem e por onde passa
flowchart TB
  subgraph PC["PC do profissional (Windows ou Linux) · app cliente Electron 45"]
    direction LR
    TELAS["<b>Telas</b><br/>React 19 + Mantine<br/><i>processo de renderização (isolado)</i>"]
    NUCLEO["<b>Núcleo local</b><br/>Node.js 24 + TypeScript<br/>repositórios · fila (outbox) · sincronização<br/>sessão · login offline · logs locais"]
    SQLITE[("<b>SQLite</b><br/>node:sqlite<br/>cópia dos dados + fila")]
